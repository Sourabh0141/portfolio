---
// Astro writes this page to 404.html. The host serves it for any path that does not exist.
import BaseLayout from '../layouts/BaseLayout.astro';
---

{/*
  noindex keeps this URL out of search results. follow still allows the link home to be crawled.
*/}
<BaseLayout title="Page not found — Sourabh Sharma" description="That page doesn’t exist." noindex>
  <section class="not-found">
    <div class="container">
      <p class="label label--accent">Error 404</p>
      <h1>This page doesn’t exist.</h1>
      <p>The link may be old or mistyped. Everything lives on the home page.</p>
      <a class="btn btn--primary" href="/">
        Back to the portfolio
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Center the message in the space under the header. */
  .not-found {
    display: grid;
    min-height: 60vh;
    place-items: center;
    padding-block: var(--section-pad);
  }

  .container {
    display: grid;
    justify-items: start;
    gap: 1.25rem;
  }

  /* About two short lines, at any viewport width. */
  h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 8vw, 4.5rem);
  }

  /* The label above keeps its accent color. Only this sentence is muted. */
  p:not(.label) {
    max-width: 44ch;
    color: var(--text-muted);
  }
</style>
