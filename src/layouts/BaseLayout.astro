---
// Shared document for every page. The page body is passed in through the default slot.
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import Munshi from '../components/chat/Munshi.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { profile } from '../data/site';
import { munshiConfig as munshi } from '../lib/munshi';
import { SITE_URL } from '../site.config';
import '../styles/global.css';

export interface Props {
  title?: string | undefined;
  description?: string | undefined;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// `munshi` is null when the build has no chat settings. The page is then exactly as it was.
const munshiLinks = munshi
  ? [
      SITE_URL,
      new URL(profile.resume.href, SITE_URL).href,
      ...(await getCollection('projects')).flatMap((project) =>
        project.data.links.map((link) => link.url),
      ),
    ]
  : [];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/*
      Inline so this runs before first paint. A bundled script would load too late and the theme would flash.
      If localStorage throws, the operating-system preference is used instead.
    */}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add('js');
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme =
            window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        }
        root.setAttribute('data-theme', theme);
      })();
    </script>
    <SeoHead title={title} description={description} noindex={noindex} />
    {/* Display and body are preloaded. Mono is used less, so it is not. */}
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader />
    {/* tabindex="-1" lets the skip link focus main without putting main in the tab order. */}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    {munshi && <Munshi config={munshi} links={munshiLinks} />}
    {/* Bundled page behavior. The page stays usable if this script never runs. */}
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
