---
export interface Props {
  steps: readonly string[];
  /** "wrap" is the row on a normal card. "stack" is the column beside a featured card. */
  variant?: 'stack' | 'wrap';
  title: string;
}

const { steps, variant = 'wrap', title } = Astro.props;
---

<figure class:list={['flow', `flow--${variant}`]}>
  <figcaption class="label">Data flow · {title}</figcaption>
  <ol>
    {steps.map((step, i) => (
      <li>
        <span class="flow__num" aria-hidden="true">
          {String(i + 1).padStart(2, '0')}
        </span>
        <span>{step}</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .flow {
    margin: 0;
  }

  figcaption {
    margin-bottom: 0.75rem;
  }

  li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
    font-size: 0.875rem;
    line-height: 1.35;
  }

  .flow__num {
    color: var(--accent-text);
    font-family: var(--font-code);
    font-size: 0.6875rem;
  }

  .flow--wrap ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
  }

  .flow--wrap li {
    padding: 0.4rem 0.7rem;
  }

  .flow--wrap li:not(:last-child)::after {
    content: '→';
    /* The slash form gives the arrow empty alternative text, so it is not announced. */
    content: '→' / '';
    position: absolute;
    left: calc(100% + 0.2rem);
    top: 50%;
    translate: 0 -50%;
    color: var(--text-faint);
    font-family: var(--font-code);
  }

  .flow--stack ol {
    display: grid;
    gap: 1.5rem;
  }

  .flow--stack li {
    padding: 0.8rem 1rem;
    font-size: 0.9375rem;
  }

  .flow--stack li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 1.4rem;
    top: 100%;
    width: 1px;
    height: 1.5rem;
    background: repeating-linear-gradient(to bottom, var(--accent) 0 4px, transparent 4px 8px);
  }
</style>
