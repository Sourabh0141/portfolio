---
/**
 * Decorative "signal path" diagram of the kind of systems Sourabh builds
 * (client → MQTT broker → FastAPI → workers → models → storage).
 * Purely illustrative, so it is hidden from assistive technology.
 */
const nodes = [
  { x: 16, y: 28, label: 'Client', sub: 'web · mobile' },
  { x: 264, y: 28, label: 'EMQX', sub: 'MQTT · JWT' },
  { x: 140, y: 148, label: 'FastAPI', sub: 'async services' },
  { x: 16, y: 268, label: 'Celery', sub: 'background tasks' },
  { x: 264, y: 268, label: 'Models', sub: 'YOLO · SAM · LLM' },
  { x: 140, y: 372, label: 'Storage', sub: 'PostgreSQL · MinIO' },
] as const;

const paths = [
  'M156 52 H264',
  'M334 76 V112 H210 V148',
  'M176 196 V232 H86 V268',
  'M244 196 V232 H334 V268',
  'M86 316 V344 H176 V372',
  'M334 316 V344 H244 V372',
];

const NODE_W = 140;
const NODE_H = 48;
---

<div class="hero-diagram" aria-hidden="true">
  <svg viewBox="0 0 420 440" role="presentation" focusable="false">
    {paths.map((d) => (
      <path class="hero-diagram__wire" d={d} />
    ))}
    {paths.map((d) => (
      <path class="hero-diagram__pulse" d={d} />
    ))}
    {nodes.map((n) => (
      <g>
        <rect class="hero-diagram__node" x={n.x} y={n.y} width={NODE_W} height={NODE_H} rx="3" />
        <text class="hero-diagram__label" x={n.x + 14} y={n.y + 21}>
          {n.label}
        </text>
        <text class="hero-diagram__sub" x={n.x + 14} y={n.y + 37}>
          {n.sub}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .hero-diagram {
    display: none;
  }

  @media (min-width: 60rem) {
    .hero-diagram {
      display: block;
      align-self: center;
      padding: 1.25rem;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background:
        linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 2.5rem,
        var(--bg-raised);
    }
  }

  svg {
    width: 100%;
    height: auto;
  }

  .hero-diagram__wire,
  .hero-diagram__pulse {
    fill: none;
    stroke-linejoin: round;
  }

  .hero-diagram__wire {
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .hero-diagram__pulse {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 3 14;
  }

  .hero-diagram__node {
    fill: var(--bg);
    stroke: var(--line-strong);
    stroke-width: 1.5;
  }

  .hero-diagram__label {
    fill: var(--text);
    font-family: var(--font-code);
    font-size: 13px;
    font-weight: 500;
  }

  .hero-diagram__sub {
    fill: var(--text-muted);
    font-family: var(--font-code);
    font-size: 9.5px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-diagram__pulse {
      animation: pulse-flow 1.6s linear infinite;
    }
  }

  @keyframes pulse-flow {
    to {
      stroke-dashoffset: -17;
    }
  }
</style>
