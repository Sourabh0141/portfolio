---
import { profile, socials } from '../../data/site';
import Icon from '../Icon.astro';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__content">
    <p class="label label--accent hero__eyebrow">
      <span class="hero__dot" aria-hidden="true"></span>
      {profile.role} · {profile.specialty}
    </p>

    <h1 id="hero-title" class="hero__title">
      {/* profile.name is one string. The break is set here so the two names stay on their own lines. */}
      Sourabh
      <br />
      Sharma
    </h1>

    <p class="hero__headline">{profile.headline}</p>
    <p class="hero__lead">{profile.lead}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#contact">
        Get in touch
        <Icon name="mail" size={18} />
      </a>
      <a class="btn" href={profile.resume.href} download>
        Download resume
        <Icon name="download" size={18} />
      </a>
    </div>

    <ul class="hero__links">
      {socials.map((s) => (
        <li>
          <a href={s.url} rel="noopener noreferrer" target="_blank">
            <Icon name={s.id} size={18} />
            {s.label}
            <span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      ))}
    </ul>

    <dl class="hero__meta">
      <div>
        <dt class="label">Based in</dt>
        <dd>{profile.location}</dd>
      </div>
      <div>
        <dt class="label">Currently</dt>
        {/* Shorter than profile.employer, which is the legal company name. */}
        <dd>Associate Software Developer, Predusk</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(3.5rem, 8vw, 6rem);
  }

  .hero__content {
    max-width: 54rem;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
  }

  .hero__dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .hero__title {
    margin-bottom: 1.75rem;
    font-size: clamp(3.25rem, 13.5vw, 7.25rem);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .hero__headline {
    max-width: 38ch;
    margin-bottom: 1rem;
    font-family: var(--font-head);
    font-size: clamp(1.35rem, 3.6vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .hero__lead {
    max-width: 54ch;
    margin-bottom: 2rem;
    color: var(--text-muted);
    font-size: clamp(1rem, 2.2vw, 1.125rem);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin-bottom: 2.5rem;
  }

  .hero__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .hero__links a:hover {
    color: var(--accent-text);
    text-decoration: underline;
  }

  .hero__meta {
    display: grid;
    gap: 1rem 2.5rem;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .hero__meta dd {
    margin: 0.25rem 0 0;
  }

  @media (max-width: 29.99rem) {
    .hero__actions .btn {
      flex: 1 1 100%;
    }
  }

  @media (min-width: 40rem) {
    .hero__meta {
      grid-auto-flow: column;
      justify-content: start;
    }
  }
</style>
