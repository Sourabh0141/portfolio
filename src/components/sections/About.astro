---
import { about, education, focusAreas } from '../../data/site';
import SectionHeading from '../SectionHeading.astro';
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container">
    <SectionHeading
      id="about-title"
      index="04"
      eyebrow="About"
      title="Engineering for systems that have to stay up."
    />

    <div class="about">
      <div class="about__text reveal">
        {about.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>

      <div class="about__aside reveal">
        <section aria-labelledby="focus-title">
          <h3 id="focus-title" class="label label--accent">
            Focus areas
          </h3>
          <ul class="about__focus">
            {focusAreas.map((area, i) => (
              <li>
                <span class="about__num" aria-hidden="true">
                  {/* Visual only. The words beside the number are what get announced. */}
                  {String(i + 1).padStart(2, '0')}
                </span>
                {area}
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="education-title" class="about__education">
          <h3 id="education-title" class="label label--accent">
            Education
          </h3>
          <p class="about__degree">{education.degree}</p>
          <p class="about__school">{education.institution}</p>
          <p class="label">
            {education.period} · {education.location}
          </p>
        </section>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .about__text {
    display: grid;
    gap: 1.25rem;
    max-width: 62ch;
    font-size: clamp(1.0625rem, 2.2vw, 1.25rem);
    line-height: 1.6;
  }

  /* The opening paragraph stays at full contrast. The ones after it are secondary. */
  .about__text p:first-child {
    color: var(--text);
  }

  .about__text p + p {
    color: var(--text-muted);
  }

  .about__aside {
    display: grid;
    align-content: start;
    gap: 2.5rem;
  }

  .about__focus {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .about__focus li {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .about__num {
    color: var(--accent-text);
    font-family: var(--font-code);
    font-size: 0.75rem;
  }

  .about__education {
    display: grid;
    gap: 0.4rem;
  }

  .about__education h3 {
    margin-bottom: 0.4rem;
  }

  .about__degree {
    font-family: var(--font-head);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .about__school {
    color: var(--text-muted);
  }

  @media (min-width: 56rem) {
    .about {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    }
  }
</style>
