# Top-most EditorConfig file; stop searching parent directories
root = true

# Apply baseline formatting rules to all files across the repository
[*]
# Use UTF-8 character encoding
charset = utf-8

# Enforce Unix-style line feeds (\n) across Windows, macOS, and Linux
end_of_line = lf

# Use 2 spaces per indentation level instead of tabs
indent_style = space
indent_size = 2

# Ensure every file ends with a newline character (POSIX compliance)
insert_final_newline = true

# Strip any trailing whitespace characters before saving
trim_trailing_whitespace = true
