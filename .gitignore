# Build outputs & framework caches
dist/
.astro/
.wrangler/

# Third-party dependencies
node_modules/

# Logs
*.log

# Temporary files
# tmp/*
!tmp/.gitkeep

# Environment variables & local secrets
.env
.env.*
.dev.vars

# Munshi Worker: files generated on every build (knowledge base, runtime types)
worker/src/generated/
worker/worker-configuration.d.ts

# Terraform: provider cache, state and plans. The lock file is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
crash.log

# TypeScript cache
*.tsbuildinfo

# Operating system metadata
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
