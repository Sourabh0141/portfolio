# Public build settings for Munshi, the chat assistant. Nothing in this file is a secret:
# both values end up in the page that every visitor downloads.
#
# Copy to `.env` to try the chat locally. Leave them unset and the site builds without it.
#
# Local development (three terminals):
#   npm run dev:upstream -w worker   stand-in for DeepInfra and Turnstile verification
#   npm run dev -w worker            the Worker, on http://localhost:8787
#   npm run dev                      the site, on http://localhost:4321
#
# In production CI sets both from Terraform outputs. See .github/workflows/ci-cd.yml.

PUBLIC_MUNSHI_API_URL=http://localhost:8787

# Cloudflare's published test key. It always passes and works on any hostname.
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
